#!/bin/sh
set -eu

workspace=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$workspace/Cargo.toml" | head -n 1)
DITCH_BUILD_IDENTIFIER=${DITCH_BUILD_IDENTIFIER:-$("$workspace/scripts/build-identifier")}
case "$DITCH_BUILD_IDENTIFIER" in
  *[!A-Za-z0-9._-]*) echo 'error: invalid DITCH_BUILD_IDENTIFIER' >&2; exit 1 ;;
esac
export DITCH_BUILD_IDENTIFIER
remote_protocol=$(sed -n 's/^pub const REMOTE_RUNTIME_PROTOCOL_VERSION: u16 = \([0-9][0-9]*\);/\1/p' "$workspace/crates/ditch_protocol/src/lib.rs")
[ -n "$remote_protocol" ] || { echo 'error: remote runtime protocol version was not found' >&2; exit 1; }
community_revision=$(git -C "$workspace" rev-parse HEAD)
output=${DITCH_REMOTE_ARTIFACT_OUTPUT:-"$workspace/dist/remote/$version"}
targets=${DITCH_REMOTE_TARGETS:-"x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu aarch64-apple-darwin x86_64-apple-darwin"}
docker_image=${DITCH_REMOTE_DOCKER_IMAGE:-"rust:1.97-bookworm"}
docker_cache=''

cleanup() {
  if [ -n "$docker_cache" ] && [ -d "$docker_cache" ]; then
    rm -rf "$docker_cache"
  fi
}
trap cleanup EXIT HUP INT TERM

target_std_available() {
  target_libdir=$(rustc --print target-libdir --target "$1" 2>/dev/null || true)
  [ -n "$target_libdir" ] || return 1
  set -- "$target_libdir"/libstd-*.rlib
  [ -f "$1" ]
}

rustup_target_std_available() {
  command -v rustup >/dev/null 2>&1 || return 1
  target_libdir=$(rustup run stable rustc --print target-libdir --target "$1" 2>/dev/null || true)
  [ -n "$target_libdir" ] || return 1
  set -- "$target_libdir"/libstd-*.rlib
  [ -f "$1" ]
}

build_linux_with_docker() {
  target=$1
  case "$target" in
    x86_64-unknown-linux-gnu) platform=linux/amd64 ;;
    aarch64-unknown-linux-gnu) platform=linux/arm64 ;;
    *) return 1 ;;
  esac
  if [ -z "$docker_cache" ]; then
    docker_cache=$(mktemp -d "${TMPDIR:-/tmp}/ditch-remote-cargo.XXXXXX")
  fi
  echo "Building $target in Docker ($platform)"
  docker run --rm --platform "$platform" \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -e CARGO_HOME=/cargo \
    -e DITCH_BUILD_IDENTIFIER="$DITCH_BUILD_IDENTIFIER" \
    -e CARGO_TARGET_DIR="/workspace/target/$target" \
    -v "$workspace:/workspace" \
    -v "$docker_cache:/cargo" \
    -w /workspace \
    "$docker_image" \
    cargo build --locked --release -p ditchd
}

build_target() {
  target=$1
  if target_std_available "$target"; then
    cargo build --locked --release --target "$target" -p ditchd
    return
  fi
  if rustup_target_std_available "$target"; then
    rustup_rustc=$(rustup which --toolchain stable rustc)
    RUSTC="$rustup_rustc" rustup run stable cargo build --locked --release --target "$target" -p ditchd
    return
  fi
  case "$target" in
    *-unknown-linux-gnu)
      if command -v docker >/dev/null 2>&1; then
        build_linux_with_docker "$target"
        return
      fi
      ;;
  esac
  echo "error: Rust standard library for $target is unavailable." >&2
  echo "Install the target for the active toolchain with rustup, or install Docker for Linux artifacts." >&2
  exit 1
}

mkdir -p "$output"
manifest="$output/remote-artifacts.json"
temporary="$manifest.tmp"

printf '{\n  "edition": "community",\n  "version": "%s",\n  "build_identifier": "%s",\n  "community_revision": "%s",\n  "remote_runtime_protocol_version": %s,\n  "artifacts": [\n' \
  "$version" "$DITCH_BUILD_IDENTIFIER" "$community_revision" "$remote_protocol" > "$temporary"
has_artifact=''
for target in $targets; do
  build_target "$target"
  source_binary="$workspace/target/$target/release/ditchd"
  artifact="ditchd-$target"
  cp "$source_binary" "$output/$artifact"
  chmod 700 "$output/$artifact"
  if command -v shasum >/dev/null 2>&1; then
    checksum=$(shasum -a 256 "$output/$artifact" | awk '{print $1}')
  else
    checksum=$(sha256sum "$output/$artifact" | awk '{print $1}')
  fi
  if [ -n "$has_artifact" ]; then
    printf ',\n' >> "$temporary"
  fi
  printf '    {"target":"%s","sha256":"%s","artifact":"%s"}' \
    "$target" "$checksum" "$artifact" >> "$temporary"
  has_artifact=1
done
printf '\n  ]\n}\n' >> "$temporary"
mv "$temporary" "$manifest"
printf 'Remote artifacts written to %s\n' "$output"
