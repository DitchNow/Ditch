#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
destination=${1:-"$repo_dir/build/remote-contract-v1"}

mkdir -p "$destination"
cp "$repo_dir/docs/remote/REMOTE_PROTOCOL_V1.md" "$destination/"
cp "$repo_dir/docs/remote/openapi-v1.yaml" "$destination/"
cp -R "$repo_dir/docs/remote/schemas" "$destination/"
cp -R "$repo_dir/docs/remote/fixtures" "$destination/"
(
  cd "$destination"
  find . -type f ! -name SHA256SUMS -print | LC_ALL=C sort | xargs shasum -a 256 > SHA256SUMS
)
printf '%s\n' "$destination"
