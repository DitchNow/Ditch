+package renderers
+
+import (
+	"github.com/ollama/ollama/api"
+	"strings"
+	"testing"
+)
+
+func TestQwen35PreservesDeveloperInstructions(t *testing.T) {
+	r := &Qwen35Renderer{}
+	messages := []api.Message{
+		{Role: "system", Content: "SYSTEM-FIRST"},
+		{Role: "developer", Content: "DEVELOPER-SECOND"},
+		{Role: "user", Content: "USER-MARKER"},
+		{Role: "assistant", Content: "ASSISTANT-MARKER"},
+		{Role: "developer", Content: "DEVELOPER-THIRD"},
+		{Role: "user", Content: "FINAL-USER"},
+	}
+	for _, tools := range [][]api.Tool{nil, {{Type: "function", Function: api.ToolFunction{Name: "probe"}}}} {
+		got, err := r.Render(messages, tools, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		previous := -1
+		for _, marker := range []string{"SYSTEM-FIRST", "DEVELOPER-SECOND", "DEVELOPER-THIRD", "USER-MARKER", "ASSISTANT-MARKER", "FINAL-USER"} {
+			index := strings.Index(got, marker)
+			if index <= previous {
+				t.Fatalf("missing or reordered %s", marker)
+			}
+			previous = index
+		}
+	}
+}
