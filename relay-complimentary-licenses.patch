new file mode 100644
--- /dev/null
+++ b/src/billing/complimentary.ts
@@ -0,0 +1,109 @@
+import { AuthError, rateLimit } from "../auth";
+import { bodyObject, json, requestId, requiredString } from "../http";
+import { requireInternal } from "../releases";
+import type { Env } from "../types";
+import { reconcileOwnerEntitlements } from "./entitlements";
+import { ensureOwnerLicenseKey, generateLicenseKey, licenseHash, licenseInternals } from "./licenses";
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
+interface ComplimentaryLicense {
+  id: string; environment: string; license_hash: string; license_prefix: string; license_last4: string;
+  key_ciphertext: string; key_iv: string; reason: string; mac_slots: number; ios_slots: number;
+  expires_at: number | null; state: "unclaimed" | "claimed" | "revoked"; claimed_owner_id: string | null;
+  claimed_at: number | null; created_at: number; updated_at: number; revoked_at: number | null;
+}
+function context(env: Env, id: string): string { return `DITCH-COMPLIMENTARY-LICENSE-1\0${env.ENVIRONMENT}\0${id}`; }
+function slots(value: unknown): number {
+  if (!Number.isSafeInteger(value) || Number(value) < 1 || Number(value) > 1000) throw new AuthError("validation_failed");
+  return Number(value);
+}
+function metadata(row: ComplimentaryLicense) {
+  return { license_id: row.id, environment: row.environment, prefix: row.license_prefix, last4: row.license_last4,
+    reason: row.reason, mac_slots: row.mac_slots, ios_slots: row.ios_slots, remote_node_slots: null,
+    expires_at: row.expires_at, state: row.state, claimed_owner_id: row.claimed_owner_id,
+    claimed_at: row.claimed_at, created_at: row.created_at, revoked_at: row.revoked_at };
+}
+async function find(env: Env, id: string): Promise<ComplimentaryLicense | null> {
+  if (!UUID.test(id)) throw new AuthError("validation_failed");
+  return env.DB.prepare("SELECT * FROM complimentary_licenses WHERE id=? AND environment=?")
+    .bind(id, env.ENVIRONMENT).first<ComplimentaryLicense>();
+}
+
+export async function issueComplimentaryLicense(request: Request, env: Env): Promise<Response> {
+  requireInternal(request, env);
+  await rateLimit(env, "complimentary-license-issue", 30, 60_000);
+  const body = await bodyObject(request);
+  if (Object.keys(body).some((key) => !["license_id","reason","mac_slots","ios_slots","expires_at"].includes(key))) throw new AuthError("validation_failed");
+  const id = requiredString(body, "license_id", 36);
+  const reason = requiredString(body, "reason", 500).trim();
+  if (!reason) throw new AuthError("validation_failed");
+  const macSlots = slots(body.mac_slots === undefined ? 2 : body.mac_slots);
+  const iosSlots = slots(body.ios_slots === undefined ? 2 : body.ios_slots);
+  const expiresAt = body.expires_at === undefined || body.expires_at === null ? null : body.expires_at;
+  if (expiresAt !== null && (!Number.isSafeInteger(expiresAt) || Number(expiresAt) > 8_640_000_000_000_000)) throw new AuthError("validation_failed");
+  let row = await find(env, id);
+  let created = false;
+  if (!row) {
+    const now = Date.now();
+    if (expiresAt !== null && Number(expiresAt) <= now) throw new AuthError("validation_failed");
+    const rawKey = generateLicenseKey();
+    const encrypted = await licenseInternals.encryptForDisplay(rawKey, env.DITCH_LICENSE_PEPPER, context(env, id));
+    const result = await env.DB.prepare(`INSERT INTO complimentary_licenses(id,environment,license_hash,license_prefix,license_last4,
+        key_ciphertext,key_iv,reason,mac_slots,ios_slots,expires_at,state,created_at,updated_at)
+      VALUES(?,?,?,?,?,?,?,?,?,?,?,'unclaimed',?,?) ON CONFLICT(id) DO NOTHING`)
+      .bind(id, env.ENVIRONMENT, await licenseHash(env, rawKey), rawKey.split("-").slice(0,2).join("-"), rawKey.slice(-4),
+        encrypted.ciphertext, encrypted.iv, reason, macSlots, iosSlots, expiresAt, now, now).run();
+    created = result.meta.changes > 0;
+    row = await find(env, id);
+  }
+  if (!row || row.reason !== reason || row.mac_slots !== macSlots || row.ios_slots !== iosSlots || row.expires_at !== expiresAt) {
+    throw new AuthError("complimentary_license_conflict");
+  }
+  if (row.state === "revoked") throw new AuthError("license_invalid");
+  const rawKey = await licenseInternals.decryptForDisplay(row.key_ciphertext, row.key_iv, env.DITCH_LICENSE_PEPPER, context(env, id));
+  if (await licenseHash(env, rawKey) !== row.license_hash) throw new Error("complimentary_license_integrity_failed");
+  return json({ ...metadata(row), license_key: rawKey }, created ? 201 : 200, requestId(request));
+}
+
+export async function getComplimentaryLicense(request: Request, env: Env, id: string): Promise<Response> {
+  requireInternal(request, env);
+  const row = await find(env, id);
+  if (!row) throw new AuthError("license_invalid");
+  return json(metadata(row), 200, requestId(request));
+}
+
+// A false result means this is not a complimentary key; use the existing paid-key path.
+// Recognized but expired/revoked/claimed keys never fall through to another key type.
+export async function claimComplimentaryLicense(env: Env, rawKey: string, ownerId: string, now = Date.now()): Promise<boolean> {
+  const hash = await licenseHash(env, rawKey);
+  const row = await env.DB.prepare("SELECT * FROM complimentary_licenses WHERE license_hash=? AND environment=?")
+    .bind(hash, env.ENVIRONMENT).first<ComplimentaryLicense>();
+  if (!row) return false;
+  if (row.state === "revoked" || (row.expires_at !== null && row.expires_at <= now)) throw new AuthError("license_invalid");
+  if (row.claimed_owner_id !== null && row.claimed_owner_id !== ownerId) throw new AuthError("license_already_claimed");
+  const claimed = await env.DB.prepare(`UPDATE complimentary_licenses
+    SET state='claimed',claimed_owner_id=?,claimed_at=COALESCE(claimed_at,?),updated_at=?
+    WHERE id=? AND environment=? AND state IN ('unclaimed','claimed')
+      AND (claimed_owner_id IS NULL OR claimed_owner_id=?) AND (expires_at IS NULL OR expires_at>?)
+      AND EXISTS(SELECT 1 FROM owners WHERE id=? AND state='active') RETURNING id`)
+    .bind(ownerId, now, now, row.id, env.ENVIRONMENT, ownerId, now, ownerId).first();
+  if (!claimed) {
+    const current = await find(env, row.id);
+    if (current?.state === "revoked" || (current?.expires_at != null && current.expires_at <= now)) throw new AuthError("license_invalid");
+    throw new AuthError("license_already_claimed");
+  }
+  await reconcileOwnerEntitlements(env, ownerId, now);
+  await ensureOwnerLicenseKey(env, ownerId, now);
+  return true;
+}
+
+export async function revokeComplimentaryLicense(request: Request, env: Env, id: string): Promise<Response> {
+  requireInternal(request, env);
+  if (!await find(env, id)) throw new AuthError("license_invalid");
+  const now = Date.now();
+  await env.DB.prepare(`UPDATE complimentary_licenses SET state='revoked',revoked_at=?,updated_at=?
+    WHERE id=? AND environment=? AND state!='revoked'`).bind(now, now, id, env.ENVIRONMENT).run();
+  const row = (await find(env, id))!;
+  if (row.claimed_owner_id) await reconcileOwnerEntitlements(env, row.claimed_owner_id, now);
+  return json(metadata(row), 200, requestId(request));
+}
