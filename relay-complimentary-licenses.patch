@@ -0,0 +1,75 @@
+PRAGMA foreign_keys = ON;
+
+-- Durable administrative grants, independent of payment-provider records.
+CREATE TABLE complimentary_licenses (
+  id TEXT PRIMARY KEY,
+  environment TEXT NOT NULL CHECK(environment IN ('test','staging','production')),
+  license_hash TEXT NOT NULL UNIQUE,
+  license_prefix TEXT NOT NULL,
+  license_last4 TEXT NOT NULL,
+  key_ciphertext TEXT NOT NULL,
+  key_iv TEXT NOT NULL,
+  reason TEXT NOT NULL CHECK(length(reason) BETWEEN 1 AND 500),
+  mac_slots INTEGER NOT NULL CHECK(mac_slots BETWEEN 1 AND 1000),
+  ios_slots INTEGER NOT NULL CHECK(ios_slots BETWEEN 1 AND 1000),
+  expires_at INTEGER,
+  state TEXT NOT NULL CHECK(state IN ('unclaimed','claimed','revoked')),
+  claimed_owner_id TEXT REFERENCES owners(id),
+  claimed_at INTEGER,
+  created_at INTEGER NOT NULL,
+  updated_at INTEGER NOT NULL,
+  revoked_at INTEGER,
+  CHECK(expires_at IS NULL OR expires_at > created_at),
+  CHECK((claimed_owner_id IS NULL AND claimed_at IS NULL) OR (claimed_owner_id IS NOT NULL AND claimed_at IS NOT NULL)),
+  CHECK(state != 'unclaimed' OR claimed_owner_id IS NULL),
+  CHECK(state != 'claimed' OR claimed_owner_id IS NOT NULL),
+  CHECK((state='revoked') = (revoked_at IS NOT NULL))
+);
+CREATE INDEX complimentary_licenses_owner ON complimentary_licenses(claimed_owner_id,environment,state);
+CREATE TRIGGER complimentary_license_owner_immutable
+BEFORE UPDATE OF claimed_owner_id ON complimentary_licenses
+WHEN OLD.claimed_owner_id IS NOT NULL AND NEW.claimed_owner_id IS NOT OLD.claimed_owner_id
+BEGIN SELECT RAISE(ABORT,'license_already_claimed'); END;
+CREATE TRIGGER complimentary_license_revocation_final
+BEFORE UPDATE OF state ON complimentary_licenses
+WHEN OLD.state='revoked' AND NEW.state!='revoked'
+BEGIN SELECT RAISE(ABORT,'license_invalid'); END;
+
+-- Audit transitions atomically with their source mutation; retries create no duplicates.
+-- The license ID correlates these records without logging the secret or recipient notes.
+CREATE TRIGGER complimentary_license_issued_audit AFTER INSERT ON complimentary_licenses
+BEGIN
+  INSERT INTO audit_events(id,request_id,kind,detail_code,created_at)
+    VALUES('complimentary-issued:' || NEW.id,NEW.id,'complimentary_license_issued',NEW.id,NEW.created_at);
+END;
+CREATE TRIGGER complimentary_license_claimed_audit AFTER UPDATE OF claimed_owner_id ON complimentary_licenses
+WHEN OLD.claimed_owner_id IS NULL AND NEW.claimed_owner_id IS NOT NULL
+BEGIN
+  INSERT INTO audit_events(id,owner_id,request_id,kind,detail_code,created_at)
+    VALUES('complimentary-claimed:' || NEW.id,NEW.claimed_owner_id,NEW.id,'complimentary_license_claimed',NEW.id,NEW.updated_at);
+END;
+CREATE TRIGGER complimentary_license_revoked_audit AFTER UPDATE OF state ON complimentary_licenses
+WHEN OLD.state!='revoked' AND NEW.state='revoked'
+BEGIN
+  INSERT INTO audit_events(id,owner_id,request_id,kind,detail_code,created_at)
+    VALUES('complimentary-revoked:' || NEW.id,NEW.claimed_owner_id,NEW.id,'complimentary_license_revoked',NEW.id,NEW.updated_at);
+END;
+
+-- Detect stale derived entitlements without rebuilding them on every remote-control request.
+ALTER TABLE owner_entitlements ADD COLUMN complimentary_revision INTEGER NOT NULL DEFAULT 0;
+CREATE TABLE complimentary_owner_revisions (
+  owner_id TEXT PRIMARY KEY REFERENCES owners(id) ON DELETE CASCADE,
+  revision INTEGER NOT NULL
+);
+CREATE TRIGGER complimentary_license_claim_revision AFTER UPDATE OF claimed_owner_id ON complimentary_licenses
+WHEN OLD.claimed_owner_id IS NULL AND NEW.claimed_owner_id IS NOT NULL
+BEGIN
+  INSERT INTO complimentary_owner_revisions(owner_id,revision) VALUES(NEW.claimed_owner_id,1)
+    ON CONFLICT(owner_id) DO UPDATE SET revision=revision+1;
+END;
+CREATE TRIGGER complimentary_license_revoke_revision AFTER UPDATE OF state ON complimentary_licenses
+WHEN OLD.state!='revoked' AND NEW.state='revoked' AND NEW.claimed_owner_id IS NOT NULL
+BEGIN
+  INSERT INTO complimentary_owner_revisions(owner_id,revision) VALUES(NEW.claimed_owner_id,1)
+    ON CONFLICT(owner_id) DO UPDATE SET revision=revision+1;
+END;
