+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, writeFile, readFile, stat, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { parseOptions, run } from './complimentary-license-admin.mjs';
+const id = '22222222-2222-4222-8222-222222222222';
+const fakeKey = `DITCH-${Array(6).fill('ABCDE').join('-')}`;
+const base = ['issue','production','--secret-file','secret','--reason','Personal use','--output','out'];
+test('strict environment and input validation', () => {
+  assert.equal(parseOptions(base).origin, 'https://relay.ditchnow.nl');
+  assert.equal(parseOptions([base[0], 'staging', ...base.slice(2)]).origin, 'https://ditch-remote-relay-staging.matin-1a7.workers.dev');
+  for (const extra of [['--mac-slots','0'],['--mac-slots','1.5'],['--ios-slots','1001'],['--expires-at','2026-02-30T00:00:00Z'],['--expires-at','tomorrow'],['--request-id','invalid'],['--url','https://evil.test']]) assert.throws(() => parseOptions([...base, ...extra]));
+  assert.throws(() => parseOptions(['issue','https://evil.test',...base.slice(2)]));
+  assert.throws(() => parseOptions([...base,'--reason','duplicate']));
+  assert.equal(parseOptions([...base,'--expires-at','2026-12-31T23:59:59Z']).body.expires_at, Date.parse('2026-12-31T23:59:59Z'));
+});
+test('secure receipt, explicit environment, no secret in console, no overwrite', async () => {
+  const dir = await mkdtemp(join(tmpdir(), 'ditch-license-cli-'));
+  try {
+    const secret = join(dir,'secret'), output = join(dir,'license.json');
+    await writeFile(secret,'test-only-admin-secret\n',{mode:0o600});
+    const args = ['issue','production','--secret-file',secret,'--reason','Personal use','--output',output,'--request-id',id];
+    const messages = [];
+    const io = { stdout: (v) => messages.push(v), stderr: (v) => messages.push(v) };
+    let calls = 0;
+    const fetchImpl = async (url, request) => {
+      calls++;
+      assert.equal(url,'https://relay.ditchnow.nl/v1/internal/commercial/complimentary-licenses');
+      assert.equal(request.headers.Authorization,'Bearer test-only-admin-secret');
+      assert.equal(request.redirect,'error');
+      const receipt = JSON.parse(await readFile(output,'utf8'));
+      assert.deepEqual(receipt.request,JSON.parse(request.body));
+      return Response.json({ license_id:id, environment:'production', license_key:fakeKey }, {status:201});
+    };
+    await run(args, { ...io, fetchImpl });
+    assert.equal((await stat(output)).mode & 0o777, 0o600);
+    assert.equal(JSON.parse(await readFile(output,'utf8')).license.license_key, fakeKey);
+    assert(!messages.join('').includes(fakeKey));
+    assert(!messages.join('').includes('test-only-admin-secret'));
+    await assert.rejects(run(args,{...io,fetchImpl}),/EEXIST/);
+    assert.equal(calls,1);
+  } finally { await rm(dir,{recursive:true,force:true}); }
+});
+test('failed request retains the ID and exact parameters for recovery', async () => {
+  const dir = await mkdtemp(join(tmpdir(),'ditch-license-cli-'));
+  try {
+    const secret = join(dir,'secret'), output = join(dir,'license.json');
+    await writeFile(secret,'test-only-admin-secret');
+    await assert.rejects(run(['issue','staging','--secret-file',secret,'--reason','Tester','--output',output,'--request-id',id], {
+      stdout:()=>{},stderr:()=>{},fetchImpl:async()=>Response.json({error:{code:'unauthorized'}},{status:401}),
+    }),/HTTP 401 \(unauthorized\)/);
+    const receipt = JSON.parse(await readFile(output,'utf8'));
+    assert.equal(receipt.request.license_id,id);
+    assert.equal(receipt.environment,'staging');
+    assert.equal(receipt.license,undefined);
+  } finally { await rm(dir,{recursive:true,force:true}); }
+});
+test('show and revoke use authenticated metadata routes', async () => {
+  const dir = await mkdtemp(join(tmpdir(),'ditch-license-cli-'));
+  try {
+    const secret = join(dir,'secret');await writeFile(secret,'test-only-admin-secret');
+    for (const action of ['show','revoke']) await run([action,'staging','--secret-file',secret,'--license-id',id],{
+      stdout:()=>{},stderr:()=>{},fetchImpl:async(url,request)=>{
+        assert.equal(url,`https://ditch-remote-relay-staging.matin-1a7.workers.dev/v1/internal/commercial/complimentary-licenses/${id}${action==='revoke'?'/revoke':''}`);
+        assert.equal(request.method,action==='revoke'?'POST':'GET');
+        return Response.json({license_id:id,state:action==='revoke'?'revoked':'unclaimed'});
+      },
+    });
+  } finally { await rm(dir,{recursive:true,force:true}); }
+});
