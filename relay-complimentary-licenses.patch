--- /dev/null
+++ b/test/complimentary.test.ts
@@ -0,0 +1,177 @@
+import { SELF, env } from "cloudflare:test";
+import { beforeEach, describe, expect, it } from "vitest";
+import { FakePrincipal, resetDatabase } from "./support/harness";
+import { claimComplimentaryLicense } from "../src/billing/complimentary";
+import { reconcileOwnerEntitlements, requireMachineActivation, requireRemoteControl } from "../src/billing/entitlements";
+
+const BASE = "/v1/internal/commercial/complimentary-licenses";
+const SECRET = "fixture-admin-secret";
+interface Issued { license_id: string; license_key: string; mac_slots: number; ios_slots: number; expires_at: number | null }
+function admin(path = BASE, body?: unknown, secret: string | null = SECRET, method = body === undefined ? "GET" : "POST") {
+  return SELF.fetch(`https://relay.test${path}`, { method, headers: { "Content-Type": "application/json", ...(secret === null ? {} : { Authorization: `Bearer ${secret}` }) },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
+}
+function grant(overrides: Record<string,unknown> = {}) { return { license_id: crypto.randomUUID(), reason: "Customer support gift", ...overrides }; }
+async function issue(overrides: Record<string,unknown> = {}): Promise<Issued> {
+  const response = await admin(BASE, grant(overrides));
+  expect(response.status).toBe(201);
+  expect(response.headers.get("cache-control")).toBe("no-store");
+  return response.json<Issued>();
+}
+async function owner() {
+  const machine = await FakePrincipal.create("machine", crypto.randomUUID());
+  expect((await machine.registerMachine()).status).toBe(201);
+  const response = await machine.request("/v1/commercial/bootstrap", { method: "POST" });
+  expect(response.status).toBe(200);
+  return { machine, id: (await response.json<{owner_id:string}>()).owner_id };
+}
+function redeem(machine: FakePrincipal, key: string) {
+  return machine.request("/v1/commercial/license/redeem", { method: "POST", body: { license_key: key } });
+}
+async function paidLifetime(ownerId: string) {
+  const now = Date.now();
+  await env.DB.prepare(`INSERT INTO stripe_purchases(id,owner_id,provider_mode,provider_checkout_session_id,
+      provider_customer_id,provider_price_id,purchase_type,quantity,status,provider_updated_at,created_at,updated_at)
+    VALUES(?,?,'test',?,'cus_paid','price_paid','commercial_lifetime',1,'paid',?,?,?)`)
+    .bind(crypto.randomUUID(), ownerId, `cs_${crypto.randomUUID()}`, now, now, now).run();
+}
+async function expire(id: string) {
+  await env.DB.prepare("UPDATE complimentary_licenses SET created_at=?,expires_at=? WHERE id=?")
+    .bind(Date.now() - 2000, Date.now() - 1000, id).run();
+  // Move the cached deadline too, as it would look when the real clock passes expiry.
+  await env.DB.prepare(`UPDATE owner_entitlements SET valid_until=? WHERE owner_id=
+    (SELECT claimed_owner_id FROM complimentary_licenses WHERE id=?)`).bind(Date.now() - 1000, id).run();
+}
+beforeEach(resetDatabase);
+
+describe("complimentary license administration and activation", () => {
+  it.each([null, "wrong-secret"])("requires admin authorization for every operation (%s)", async (secret) => {
+    const id = crypto.randomUUID();
+    expect((await admin(BASE, grant({ license_id: id }), secret)).status).toBe(401);
+    expect((await admin(`${BASE}/${id}`, undefined, secret)).status).toBe(401);
+    expect((await admin(`${BASE}/${id}/revoke`, {}, secret)).status).toBe(401);
+    expect(await env.DB.prepare("SELECT count(*) n FROM complimentary_licenses").first()).toEqual({ n: 0 });
+  });
+  it("does not allow a signed customer to issue licenses", async () => {
+    const { machine } = await owner();
+    expect((await machine.request(BASE, { method: "POST", body: grant() })).status).toBe(401);
+  });
+  it.each([
+    { reason: " " }, { reason: "x".repeat(501) }, { license_id: "bad" }, { mac_slots: 0 }, { mac_slots: 1001 },
+    { ios_slots: -1 }, { ios_slots: 1.5 }, { mac_slots: "2" }, { mac_slots: null }, { expires_at: 0 },
+    { expires_at: "tomorrow" }, { expires_at: 1.5 }, { expires_at: 9e15 }, { unknown: true },
+  ])("rejects invalid grant details %j", async (overrides) => {
+    expect((await admin(BASE, grant(overrides))).status).toBe(400);
+    expect(await env.DB.prepare("SELECT count(*) n FROM complimentary_licenses").first()).toEqual({ n: 0 });
+  });
+  it("issues encrypted, auditable keys and safely retries an identical issuance", async () => {
+    const body = grant();
+    const results = await Promise.all([admin(BASE, body), admin(BASE, body)]);
+    expect(results.map((r) => r.status).sort()).toEqual([200, 201]);
+    const [a,b] = await Promise.all(results.map((r) => r.json<Issued>()));
+    expect(a!.license_key).toMatch(/^DITCH-(?:[A-Z2-9]{5}-){5}[A-Z2-9]{5}$/);
+    expect(b!.license_key).toBe(a!.license_key);
+    expect(a).toMatchObject({ mac_slots: 2, ios_slots: 2, expires_at: null });
+    const row = await env.DB.prepare("SELECT * FROM complimentary_licenses").first();
+    expect(JSON.stringify(row)).not.toContain(a!.license_key);
+    expect(await env.DB.prepare("SELECT count(*) n FROM audit_events WHERE kind='complimentary_license_issued'").first()).toEqual({ n: 1 });
+    const metadata = await (await admin(`${BASE}/${a!.license_id}`)).json();
+    expect(metadata).not.toHaveProperty("license_key");
+    expect(metadata).not.toHaveProperty("key_ciphertext");
+    expect((await admin(BASE, { ...body, mac_slots: 3 })).status).toBe(409);
+    expect((await admin(BASE, { ...body, reason: "Different recipient" })).status).toBe(409);
+  });
+  it("redeems in the existing app flow without Stripe and activates the Mac", async () => {
+    const key = await issue({ mac_slots: 1, ios_slots: 3 });
+    const { machine, id } = await owner();
+    const result = await redeem(machine, key.license_key.toLowerCase());
+    expect(result.status).toBe(200);
+    expect(await result.json()).toMatchObject({ state: "claimed", entitlement: { plan: "complimentary", status: "active",
+      capabilities: { remote_control: { enabled: true, macs: { allowed: 1 }, ios: { allowed: 3 }, remote_nodes: { allowed: null } } } } });
+    expect((await machine.request(`/v1/commercial/devices/${machine.id}/activate`, { method: "POST" })).status).toBe(200);
+    await expect(requireMachineActivation(env, id, machine.id)).resolves.toBe("desktop_mac");
+    expect((await redeem(machine, key.license_key)).status).toBe(200);
+    expect((await reconcileOwnerEntitlements(env, id)).capabilities.remote_control.macs.allowed).toBe(1);
+    expect(await env.DB.prepare("SELECT count(*) n FROM stripe_purchases").first()).toEqual({ n: 0 });
+    expect(await env.DB.prepare("SELECT count(*) n FROM stripe_subscriptions").first()).toEqual({ n: 0 });
+    expect(await env.DB.prepare("SELECT count(*) n FROM audit_events WHERE kind='complimentary_license_claimed'").first()).toEqual({ n: 1 });
+    expect((await (await machine.request("/v1/commercial/offers")).json<{offers:unknown[]}>()).offers).toEqual([]);
+    const recovery = await machine.request("/v1/commercial/license");
+    expect(recovery.status).toBe(200);
+    const recoveryKey = (await recovery.json<{license_key:string}>()).license_key;
+    const second = await FakePrincipal.create("machine", crypto.randomUUID());
+    expect((await second.registerMachine()).status).toBe(201);
+    expect((await second.request("/v1/commercial/license/recover", { method: "POST", body: { license_key: recoveryKey } })).status).toBe(200);
+    expect((await second.request(`/v1/commercial/devices/${second.id}/activate`, { method: "POST" })).status).toBe(409);
+  });
+  it("allows exactly one owner to win competing claims and never grants the loser access", async () => {
+    const key = await issue();
+    const [a,b] = await Promise.all([owner(), owner()]);
+    const results = await Promise.all([redeem(a.machine, key.license_key), redeem(b.machine, key.license_key)]);
+    expect(results.map((r) => r.status).sort()).toEqual([200,409]);
+    const loser = results[0]!.status === 409 ? a : b;
+    expect((await reconcileOwnerEntitlements(env, loser.id)).capabilities.remote_control.enabled).toBe(false);
+    await expect(env.DB.prepare("UPDATE complimentary_licenses SET claimed_owner_id=?").bind(loser.id).run()).rejects.toThrow("license_already_claimed");
+  });
+  it("keeps revocation authoritative during competing redemption", async () => {
+    const key = await issue();
+    const { machine, id } = await owner();
+    await Promise.all([redeem(machine, key.license_key), admin(`${BASE}/${key.license_id}/revoke`, {})]);
+    expect((await reconcileOwnerEntitlements(env, id)).capabilities.remote_control.enabled).toBe(false);
+    await expect(requireRemoteControl(env, id)).rejects.toThrow();
+  });
+  it("rejects unknown keys and keys from another environment", async () => {
+    const key = await issue();
+    const { machine, id } = await owner();
+    expect((await redeem(machine, "DITCH-UNKNOWN")).status).toBe(400);
+    expect(await claimComplimentaryLicense({ ...env, ENVIRONMENT: "production" }, key.license_key, id)).toBe(false);
+    expect((await reconcileOwnerEntitlements({ ...env, ENVIRONMENT: "production" }, id)).capabilities.remote_control.enabled).toBe(false);
+  });
+  it("revokes unclaimed keys and denies issuance replay after revocation", async () => {
+    const body = grant();
+    const key = await (await admin(BASE, body)).json<Issued>();
+    expect((await admin(`${BASE}/${key.license_id}/revoke`, {})).status).toBe(200);
+    expect((await admin(`${BASE}/${key.license_id}/revoke`, {})).status).toBe(200);
+    expect((await admin(BASE, body)).status).toBe(400);
+    const { machine } = await owner();
+    expect((await redeem(machine, key.license_key)).status).toBe(400);
+    expect(await env.DB.prepare("SELECT count(*) n FROM audit_events WHERE kind='complimentary_license_revoked'").first()).toEqual({ n: 1 });
+    await expect(env.DB.prepare("UPDATE complimentary_licenses SET state='unclaimed',revoked_at=NULL").run()).rejects.toThrow("license_invalid");
+  });
+  it("removes access on revocation, including an already activated Mac", async () => {
+    const key = await issue();
+    const { machine, id } = await owner();
+    expect((await redeem(machine, key.license_key)).status).toBe(200);
+    expect((await machine.request(`/v1/commercial/devices/${machine.id}/activate`, { method: "POST" })).status).toBe(200);
+    expect((await admin(`${BASE}/${key.license_id}/revoke`, {})).status).toBe(200);
+    // Simulate an older concurrent reconciliation writing its pre-revocation snapshot.
+    await env.DB.prepare("UPDATE owner_entitlements SET status='active',valid_until=NULL,complimentary_revision=1 WHERE owner_id=?").bind(id).run();
+    await expect(requireMachineActivation(env, id, machine.id)).rejects.toThrow("entitlement_expired");
+    expect((await redeem(machine, key.license_key)).status).toBe(400);
+    expect((await reconcileOwnerEntitlements(env, id)).capabilities.remote_control.enabled).toBe(false);
+  });
+  it("expires claimed and unclaimed grants even when an old projection says active", async () => {
+    const key = await issue({ expires_at: Date.now() + 60_000 });
+    const { machine, id } = await owner();
+    expect((await redeem(machine, key.license_key)).status).toBe(200);
+    await expire(key.license_id);
+    await expect(requireRemoteControl(env, id)).rejects.toThrow("entitlement_expired");
+    expect((await redeem(machine, key.license_key)).status).toBe(400);
+    const unused = await issue();
+    await expire(unused.license_id);
+    expect((await redeem(machine, unused.license_key)).status).toBe(400);
+  });
+  it.each(["revoke","expire"])("preserves paid Lifetime access when a complimentary grant ends (%s)", async (operation) => {
+    const key = await issue();
+    const { machine, id } = await owner();
+    await paidLifetime(id);
+    expect((await redeem(machine, key.license_key)).status).toBe(200);
+    expect((await reconcileOwnerEntitlements(env, id)).capabilities.remote_control.macs.allowed).toBe(4);
+    if (operation === "revoke") expect((await admin(`${BASE}/${key.license_id}/revoke`, {})).status).toBe(200);
+    else await expire(key.license_id);
+    await expect(requireRemoteControl(env, id)).resolves.toBeUndefined();
+    expect(await reconcileOwnerEntitlements(env, id)).toMatchObject({ plan: "commercial_lifetime", status: "active",
+      capabilities: { remote_control: { enabled: true, macs: { allowed: 2 } } } });
+    expect(await env.DB.prepare("SELECT status FROM stripe_purchases").first()).toEqual({ status: "paid" });
+  });
+});
