        <mxCell id="edgeDaemonEngine" value="orchestrates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;startFill=1;endFill=1;strokeColor=#FF9500;strokeWidth=2;fontColor=#C93400;" edge="1" parent="1" source="ditchd" target="engine">
