<mxfile host="app.diagrams.net" modified="2026-08-18T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="ditch-architecture" name="System Architecture">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Ditch — High-Level Runtime Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1D1D1F;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="780" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Independent macOS processes, Codex execution, state flow, persistence, and failure isolation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6E6E73;" vertex="1" parent="1">
          <mxGeometry x="42" y="64" width="780" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;&lt;font color='#6E6E73'&gt;Views agents, sends prompts,&lt;br&gt;renames sessions, handles attention&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1.5;fontColor=#1D1D1F;arcSize=18;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="135" width="190" height="88" as="geometry"/>
        </mxCell>

        <mxCell id="macosBoundary" value="macOS Application Layer" style="swimlane;html=1;rounded=1;startSize=32;horizontal=1;fillColor=#F5F5F7;strokeColor=#A1A1A6;strokeWidth=1.5;fontStyle=1;fontColor=#1D1D1F;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="105" width="1240" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="uiProcess" value="&lt;b&gt;Ditch UI process&lt;/b&gt;&lt;br&gt;&lt;font color='#6E6E73'&gt;Flutter command center&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Projects and agent rows&lt;br&gt;• Conversation rendering&lt;br&gt;• Prompts and attention actions&lt;br&gt;• Snapshot reconciliation&lt;br&gt;• Runtime connection state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#007AFF;strokeWidth=2;fontColor=#1D1D1F;align=left;spacingLeft=14;spacingTop=10;arcSize=12;" vertex="1" parent="macosBoundary">
          <mxGeometry x="25" y="55" width="270" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="appkit" value="&lt;b&gt;Native AppKit shell&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Window lifecycle&lt;br&gt;• Native prompt editor&lt;br&gt;• Focus and keyboard handling&lt;br&gt;• Enter = Send&lt;br&gt;• Shift+Enter = newline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AC8FA;strokeWidth=1.5;fontColor=#1D1D1F;align=left;spacingLeft=14;spacingTop=10;arcSize=12;" vertex="1" parent="macosBoundary">
          <mxGeometry x="330" y="55" width="240" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="statusProcess" value="&lt;b&gt;Status Helper process&lt;/b&gt;&lt;br&gt;&lt;font color='#6E6E73'&gt;Independent menu-bar host&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Owns daemon lifetime&lt;br&gt;• Shows runtime health/counts&lt;br&gt;• Opens or reveals the UI&lt;br&gt;• Performs controlled shutdown&lt;br&gt;• Survives UI failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34C759;strokeWidth=2;fontColor=#1D1D1F;align=left;spacingLeft=14;spacingTop=10;arcSize=12;" vertex="1" parent="macosBoundary">
          <mxGeometry x="610" y="55" width="270" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="isolation" value="&lt;b&gt;Failure-isolation contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;Closing or crashing the Flutter UI does &lt;b&gt;not&lt;/b&gt; terminate ditchd or active Codex children. The runtime stops only through the Status Helper's explicit quit path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8ED;strokeColor=#34C759;strokeWidth=1.5;fontColor=#1D1D1F;align=left;spacingLeft=14;spacingTop=10;arcSize=12;" vertex="1" parent="macosBoundary">
          <mxGeometry x="920" y="55" width="290" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="runtimeBoundary" value="Persistent Runtime Process" style="swimlane;html=1;rounded=1;startSize=32;horizontal=1;fillColor=#F5F5F7;strokeColor=#A1A1A6;strokeWidth=1.5;fontStyle=1;fontColor=#1D1D1F;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="465" width="760" height="455" as="geometry"/>
        </mxCell>
        <mxCell id="ditchd" value="&lt;b&gt;ditchd daemon&lt;/b&gt;&lt;br&gt;&lt;font color='#6E6E73'&gt;Long-lived source of truth&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Unix-domain socket server&lt;br&gt;• Protocol validation&lt;br&gt;• Runtime snapshots and event stream&lt;br&gt;• Project and agent lifecycle&lt;br&gt;• Attention/error coordination&lt;br&gt;• Recovery after UI reconnect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AF52DE;strokeWidth=2;fontColor=#1D1D1F;align=left;spacingLeft=14;spacingTop=10;arcSize=12;" vertex="1" parent="runtimeBoundary">
          <mxGeometry x="25" y="55" width="270" height="245" as="geometry"/>
        </mxCell>
        <mxCell id="engine" value="&lt;b&gt;Codex execution engine&lt;/b&gt;&lt;br&gt;&lt;font color='#6E6E73'&gt;Internal ditchd subsystem&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Starts/resumes Codex&lt;br&gt;• Sends prompts and stop signals&lt;br&gt;• Owns child-process handles&lt;br&gt;• Parses structured JSONL&lt;br&gt;• Maps events to chat messages&lt;br&gt;• Tracks thread IDs and run state&lt;br&gt;• Converts failures into attention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9500;strokeWidth=2;fontColor=#1D1D1F;align=left;spacingLeft=14;spacingTop=10;arcSize=12;" vertex="1" parent="runtimeBoundary">
          <mxGeometry x="335" y="55" width="275" height="245" as="geometry"/>
        </mxCell>
        <mxCell id="eventPipeline" value="&lt;b&gt;State and event pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;Codex output → normalized agent state/messages → durable persistence → broadcast ServerEvent → UI reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#FF9500;strokeWidth=1.5;fontColor=#1D1D1F;align=left;spacingLeft=14;spacingTop=10;arcSize=12;" vertex="1" parent="runtimeBoundary">
          <mxGeometry x="25" y="330" width="585" height="82" as="geometry"/>
        </mxCell>

        <mxCell id="codexBoundary" value="Agent Processes" style="swimlane;html=1;rounded=1;startSize=32;horizontal=1;fillColor=#F5F5F7;strokeColor=#A1A1A6;strokeWidth=1.5;fontStyle=1;fontColor=#1D1D1F;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="465" width="440" height="455" as="geometry"/>
        </mxCell>
        <mxCell id="codexChildren" value="&lt;b&gt;Codex child processes&lt;/b&gt;&lt;br&gt;&lt;font color='#6E6E73'&gt;One independently tracked run per agent&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Execute AI-agent turns&lt;br&gt;• Read and modify project files&lt;br&gt;• Invoke tools and commands&lt;br&gt;• Emit thread/run JSONL events&lt;br&gt;• Continue without the UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF3B30;strokeWidth=2;fontColor=#1D1D1F;align=left;spacingLeft=14;spacingTop=10;arcSize=12;" vertex="1" parent="codexBoundary">
          <mxGeometry x="30" y="55" width="380" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="multiplicity" value="Agent A   •   Agent B   •   Agent N&lt;br&gt;&lt;font color='#6E6E73'&gt;Separate process state; shared daemon supervision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#FF3B30;strokeWidth=1.5;fontColor=#1D1D1F;arcSize=12;" vertex="1" parent="codexBoundary">
          <mxGeometry x="30" y="300" width="380" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="dataBoundary" value="Persistent Data and Workspaces" style="swimlane;html=1;rounded=1;startSize=32;horizontal=1;fillColor=#F5F5F7;strokeColor=#A1A1A6;strokeWidth=1.5;fontStyle=1;fontColor=#1D1D1F;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="965" width="1240" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="ditchStore" value="&lt;b&gt;Ditch SQLite store&lt;/b&gt;&lt;br&gt;Projects, agent runs, messages,&lt;br&gt;attention, recovery, user titles" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#AF52DE;strokeWidth=1.5;fontColor=#1D1D1F;" vertex="1" parent="dataBoundary">
          <mxGeometry x="25" y="45" width="260" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="codexStore" value="&lt;b&gt;Codex-owned state&lt;/b&gt;&lt;br&gt;state_5.sqlite titles and names;&lt;br&gt;session rollout history" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#FF9500;strokeWidth=1.5;fontColor=#1D1D1F;" vertex="1" parent="dataBoundary">
          <mxGeometry x="365" y="45" width="260" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="workspace" value="&lt;b&gt;Project workspaces&lt;/b&gt;&lt;br&gt;Source files, repositories,&lt;br&gt;.ditch metadata and Git state" style="shape=folder;tabWidth=60;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#1D1D1F;" vertex="1" parent="dataBoundary">
          <mxGeometry x="705" y="45" width="260" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="socket" value="&lt;b&gt;Unix socket&lt;/b&gt;&lt;br&gt;Local IPC endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1.5;fontColor=#1D1D1F;arcSize=12;" vertex="1" parent="dataBoundary">
