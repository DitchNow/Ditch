        <mxCell id="edgeUIAppKit" value="platform channel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;startFill=1;endFill=1;strokeColor=#5AC8FA;strokeWidth=1.5;fontColor=#0071A4;" edge="1" parent="1" source="uiProcess" target="appkit">
