        <mxCell id="edgeStatusDaemon" value="owns, launches, monitors, shuts down" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#34C759;strokeWidth=2;fontColor=#248A3D;" edge="1" parent="1" source="statusProcess" target="ditchd">
