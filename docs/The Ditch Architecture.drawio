        <mxCell id="edgeStatusUI" value="show / quit UI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#34C759;strokeWidth=1.5;fontColor=#248A3D;" edge="1" parent="1" source="statusProcess" target="uiProcess">
          <mxGeometry relative="1" as="geometry"/>
