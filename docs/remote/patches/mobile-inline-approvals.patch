@@ -0,0 +1,130 @@
+import 'dart:async';
+import 'dart:convert';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:the_ditch_remote/data/cache/projection_cache.dart';
+import 'package:the_ditch_remote/data/remote/protocol.dart';
+import 'package:the_ditch_remote/data/remote/realtime.dart';
+import 'package:the_ditch_remote/data/remote/remote_api.dart';
+import 'package:the_ditch_remote/data/remote/remote_repository.dart';
+import 'package:the_ditch_remote/domain/models.dart';
+import 'package:the_ditch_remote/domain/remote_state.dart';
+import 'offline_command_test.dart' show FakePlatform;
+
+class ReceiptPlatform extends FakePlatform {
+  String plaintext = '';
+  String? peer;
+  @override
+  Future<String> decrypt({
+    required String peerPublicKey,
+    required String hkdfSalt,
+    required String hkdfInfo,
+    required String aad,
+    required String nonce,
+    required String ciphertext,
+  }) async {
+    peer = peerPublicKey;
+    return plaintext;
+  }
+}
+
+class ReceiptRealtime extends MachineRealtime {
+  ReceiptRealtime(RemoteApi api)
+    : super(api: api, origin: Uri.parse('https://relay.example'));
+  // Closed by the test after completing all receipts.
+  // ignore: close_sinks
+  final events = StreamController<RemoteEnvelope>.broadcast();
+  @override
+  Stream<RemoteEnvelope> get envelopes => events.stream;
+}
+
+class ReceiptRepository extends RemoteRepository {
+  ReceiptRepository({
+    required super.api,
+    required super.platform,
+    required super.cache,
+  });
+  int sends = 0;
+  @override
+  Future<CommandReceipt> command(RemoteCommand command) async {
+    sends++;
+    return CommandReceipt(
+      commandId: command.commandId,
+      state: CommandState.accepted,
+    );
+  }
+}
+
+void main() {
+  test('approval requires decrypted Mac result, not relay delivery', () async {
+    final platform = ReceiptPlatform();
+    final api = RemoteApi(SignedHttpClient(platform), platform);
+    final channel = ReceiptRealtime(api);
+    final repository =
+        ReceiptRepository(
+            api: api,
+            platform: platform,
+            cache: ProjectionCache(platform),
+          )
+          ..authorizationState = AuthorizationState.paired
+          ..ownerId = 'owner'
+          ..machineAgreementKeys = {'mac': 'paired-mac-key'}
+          ..machineKeyVersions = {'mac': 1}
+          ..machines = [
+            MachineSummary(
+              id: 'mac',
+              name: 'Mac',
+              connection: MachineConnection.online,
+              lastSeenAt: DateTime.now(),
+            ),
+          ]
+          ..realtime = channel;
+    for (final (status, result, expected) in [
+      ('completed', 'Accepted', CommandState.succeeded),
+      ('rejected', null, CommandState.rejected),
+    ]) {
+      final command = RemoteCommand.create(
+        type: 'approval.respond',
+        machineId: 'mac',
+        payload: {'decision': 'approve_session'},
+      );
+      var finished = false;
+      final pending = repository.respondApproval(command).then((value) {
+        finished = true;
+        return value;
+      });
+      await Future<void>.delayed(Duration.zero);
+      expect(
+        finished,
+        isFalse,
+        reason: 'Relay acceptance cannot confirm runtime execution',
+      );
+      platform.plaintext = jsonEncode({
+        'command_id': command.commandId,
+        'status': status,
+        'result': result,
+        'error_code': status == 'rejected' ? 'approval_stale' : null,
+      });
+      channel.events.add(
+        RemoteEnvelope(
+          id: 'result',
+          kind: 'command_result',
+          machineId: 'mac',
+          sequence: null,
+          sentAt: DateTime.now(),
+          type: 'command_result',
+          payload: {
+            'command_id': command.commandId,
+            'expires_at': DateTime.now()
+                .add(const Duration(minutes: 1))
+                .millisecondsSinceEpoch,
+            'encrypted': {'nonce': 'nonce', 'ciphertext': 'ciphertext'},
+          },
+        ),
+      );
+      expect((await pending).state, expected);
+      expect(platform.peer, 'paired-mac-key');
+    }
+    expect(repository.sends, 2);
+    await channel.events.close();
+  });
+}
