diff --git a/lib/features/attention/inline_approval_card.dart b/lib/features/attention/inline_approval_card.dart
new file mode 100644
--- /dev/null
+++ b/lib/features/attention/inline_approval_card.dart
@@ -0,0 +1,169 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+import '../../app/app_controller.dart';
+import '../../app/approval_interaction.dart';
+import '../../domain/models.dart';
+
+class InlineApprovalCard extends StatefulWidget {
+  const InlineApprovalCard({
+    super.key,
+    required this.controller,
+    required this.interaction,
+  });
+  final AppController controller;
+  final ApprovalInteraction interaction;
+  @override
+  State<InlineApprovalCard> createState() => _InlineApprovalCardState();
+}
+
+class _InlineApprovalCardState extends State<InlineApprovalCard> {
+  Timer? _expiry;
+  bool _wasOnline = false;
+  bool _wasLive = true;
+  ApprovalInteraction get request => widget.interaction;
+  bool get online => widget.controller.canControlProject(
+    request.item.machineId,
+    request.item.projectId,
+  );
+
+  @override
+  void initState() {
+    super.initState();
+    _wasOnline = online;
+    widget.controller.addListener(_reconcile);
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (mounted && online) unawaited(_load());
+    });
+  }
+
+  void _reconcile() {
+    final live = widget.controller.attention.any(
+      (item) =>
+          item.id == request.item.id &&
+          item.machineId == request.item.machineId &&
+          item.actions.isNotEmpty,
+    );
+    final refresh = online && (!_wasOnline || (_wasLive && !live));
+    _wasOnline = online;
+    _wasLive = live;
+    if (refresh) unawaited(_load());
+  }
+
+  Future<void> _load() async {
+    await request.load(() => widget.controller.approvalDetails(request.item));
+    if (!mounted) return;
+    _expiry?.cancel();
+    final expires = request.expiresAt;
+    if (expires != null && expires.isAfter(DateTime.now())) {
+      _expiry = Timer(expires.difference(DateTime.now()), () {
+        if (mounted) setState(() {});
+      });
+    }
+  }
+
+  AllowedRemoteAction? _action(ApprovalChoice choice) {
+    final type = choice == ApprovalChoice.cancel
+        ? RemoteActionType.deny
+        : RemoteActionType.approve;
+    for (final item in widget.controller.attention) {
+      if (item.id != request.item.id ||
+          item.machineId != request.item.machineId ||
+          item.sessionId != request.item.sessionId ||
+          item.projectId != request.item.projectId) {
+        continue;
+      }
+      for (final action in item.actions) {
+        if (action.type == type) return action;
+      }
+    }
+    return null;
+  }
+
+  @override
+  void dispose() {
+    widget.controller.removeListener(_reconcile);
+    _expiry?.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => ListenableBuilder(
+    listenable: Listenable.merge([widget.controller, request]),
+    builder: (context, _) => Card(
+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(
+              'Approval required',
+              style: Theme.of(context).textTheme.titleSmall,
+            ),
+            const SizedBox(height: 8),
+            Text(
+              request.details?['summary'] as String? ?? request.item.summary,
+            ),
+            if (request.details?['command'] case final String command
+                when command.isNotEmpty) ...[
+              const SizedBox(height: 8),
+              SelectableText(
+                command,
+                style: const TextStyle(fontFamily: 'monospace'),
+              ),
+            ],
+            if (request.details?['target'] case final String target
+                when target.isNotEmpty) ...[
+              const SizedBox(height: 8),
+              Text('Target: $target'),
+            ],
+            const SizedBox(height: 12),
+            if (request.resolution != null || request.expired)
+              Text(request.resolution ?? 'Expired')
+            else ...[
+              Wrap(
+                spacing: 8,
+                runSpacing: 8,
+                children: [
+                  for (final choice in ApprovalChoice.values)
+                    OutlinedButton(
+                      onPressed:
+                          online &&
+                              request.actionable &&
+                              _action(choice) != null
+                          ? () => request.choose(
+                              choice,
+                              () => widget.controller.executeAttention(
+                                request.item,
+                                _action(choice)!,
+                                forSession: choice == ApprovalChoice.session,
+                              ),
+                            )
+                          : null,
+                      child: Text(choice.label),
+                    ),
+                ],
+              ),
+              if (request.loading) const Text('Loading request…'),
+              if (request.submitting) const Text('Waiting for the runtime…'),
+              if (!online) const Text('Reconnect to respond to this request.'),
+              if (request.error != null) Text(request.error!),
+              if (request.awaitingConfirmation)
+                const Text(
+                  'This decision will not be sent again while its result is unknown.',
+                ),
+              if (request.error != null ||
+                  request.awaitingConfirmation ||
+                  request.details == null)
+                TextButton(
+                  onPressed: online && !request.loading && !request.submitting
+                      ? _load
+                      : null,
+                  child: const Text('Check status'),
+                ),
+            ],
+          ],
+        ),
+      ),
+    ),
+  );
+}
