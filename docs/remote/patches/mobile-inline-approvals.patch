@@ -0,0 +1,69 @@
+import 'dart:async';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:the_ditch_remote/app/approval_interaction.dart';
+import 'package:the_ditch_remote/domain/errors.dart';
+import 'package:the_ditch_remote/data/remote/protocol.dart';
+import 'package:the_ditch_remote/data/remote/remote_repository.dart';
+import 'widget_screens_test.dart' as fixtures;
+
+void main() {
+  test(
+    'relay delivery and unknown results never claim approval or resend',
+    () async {
+      for (final status in [CommandState.accepted, CommandState.unknown]) {
+        final request = ApprovalInteraction(
+          fixtures.controller().attention.single,
+        );
+        await request.load(() async => {'summary': 'Run tests'});
+        var sends = 0;
+        Future<CommandReceipt?> send() async {
+          sends++;
+          return CommandReceipt(commandId: 'command', state: status);
+        }
+
+        await request.choose(ApprovalChoice.once, send);
+        await request.choose(ApprovalChoice.session, send);
+        expect(sends, 1);
+        expect(request.resolution, isNull);
+        expect(request.awaitingConfirmation, isTrue);
+        await request.load(
+          () async => throw const DitchException(
+            RemoteErrorCode.approvalStale,
+            'resolved elsewhere',
+          ),
+        );
+        expect(request.actionable, isFalse);
+        expect(request.resolution, 'No longer awaiting approval');
+      }
+    },
+  );
+  test('cancelled owner authentication permits a later decision', () async {
+    final request = ApprovalInteraction(fixtures.controller().attention.single);
+    await request.load(() async => {});
+    await request.choose(ApprovalChoice.once, () async => null);
+    expect(request.actionable, isTrue);
+    expect(request.resolution, isNull);
+  });
+  test(
+    'a disconnected details query does not resolve or discard a card',
+    () async {
+      final request = ApprovalInteraction(
+        fixtures.controller().attention.single,
+      );
+      await request.load(() async => throw TimeoutException('offline'));
+      expect(request.resolution, isNull);
+      expect(request.actionable, isFalse);
+      await request.load(() async => {});
+      expect(request.actionable, isTrue);
+    },
+  );
+  test('session approval retains destructive command classification', () {
+    final command = RemoteCommand.create(
+      type: 'approval.respond',
+      machineId: 'mac',
+      payload: {'decision': 'approve_session'},
+    );
+    expect(command.isDestructive, isTrue);
+    expect(command.isSensitive, isTrue);
+  });
+}
