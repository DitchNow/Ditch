@@ -0,0 +1,97 @@
+import 'package:flutter/foundation.dart';
+import '../data/remote/protocol.dart';
+import '../data/remote/remote_repository.dart';
+import '../domain/errors.dart';
+import '../domain/models.dart';
+
+enum ApprovalChoice { session, cancel, once }
+
+extension ApprovalChoiceLabel on ApprovalChoice {
+  String get label => switch (this) {
+    ApprovalChoice.session => 'Approve in this session',
+    ApprovalChoice.cancel => 'Cancel',
+    ApprovalChoice.once => 'Approve once',
+  };
+  String get result => switch (this) {
+    ApprovalChoice.session => 'Approved in this session',
+    ApprovalChoice.cancel => 'Cancelled',
+    ApprovalChoice.once => 'Approved once',
+  };
+}
+
+/// Survives chat navigation so a pending command cannot be sent twice.
+class ApprovalInteraction extends ChangeNotifier {
+  ApprovalInteraction(this.item);
+  final AttentionItem item;
+  Map<String, dynamic>? details;
+  bool loading = false;
+  bool submitting = false;
+  bool awaitingConfirmation = false;
+  String? resolution;
+  String? error;
+  DateTime? get expiresAt =>
+      DateTime.tryParse(details?['expires_at']?.toString() ?? '');
+  bool get expired => expiresAt?.isBefore(DateTime.now()) ?? false;
+  bool get actionable =>
+      details != null &&
+      resolution == null &&
+      !expired &&
+      !submitting &&
+      !awaitingConfirmation &&
+      !loading;
+
+  Future<void> load(Future<Map<String, dynamic>> Function() fetch) async {
+    if (loading || resolution != null) return;
+    loading = true;
+    error = null;
+    notifyListeners();
+    try {
+      details = await fetch();
+    } on DitchException catch (caught) {
+      if (caught.code == RemoteErrorCode.approvalStale) {
+        resolution = 'No longer awaiting approval';
+      } else {
+        error = caught.userMessage;
+      }
+    } on Object {
+      error =
+          'Could not load this request. Check the connection and try again.';
+    } finally {
+      loading = false;
+      notifyListeners();
+    }
+  }
+
+  Future<void> choose(
+    ApprovalChoice choice,
+    Future<CommandReceipt?> Function() send,
+  ) async {
+    if (!actionable) return;
+    submitting = true;
+    error = null;
+    notifyListeners();
+    try {
+      final receipt = await send();
+      // Cancelling device authentication leaves the request untouched.
+      if (receipt == null) return;
+      if (receipt.state == CommandState.succeeded) {
+        resolution = choice.result;
+      } else if (receipt.errorCode == RemoteErrorCode.approvalStale) {
+        resolution = 'No longer awaiting approval';
+      } else {
+        awaitingConfirmation = true;
+        error = receipt.state == CommandState.rejected
+            ? 'The runtime did not confirm this decision. Check request status.'
+            : 'Waiting for confirmation from the runtime.';
+      }
+    } on Object catch (caught) {
+      error = caught is DitchException
+          ? caught.userMessage
+          : 'Connection interrupted. The result is not known yet.';
+      awaitingConfirmation = true;
+    } finally {
+      submitting = false;
+      notifyListeners();
+    }
+  }
+}
