   Uri uri,
   Map<String, String> headers,
-) async =>
-    IoRemoteSocket(await WebSocket.connect(uri.toString(), headers: headers));
+) async {
+  final pending = WebSocket.connect(uri.toString(), headers: headers);
+  var expired = false;
+  // Close a connection that succeeds after its caller has already timed out.
+  unawaited(
+    pending.then((socket) {
+      if (expired) unawaited(socket.close());
+    }, onError: (Object _) {}),
+  );
+  // Ownership transfers to IoRemoteSocket, whose close method disposes it.
+  // ignore: close_sinks
+  final socket = await pending.timeout(
+    const Duration(seconds: 15),
+    onTimeout: () {
+      expired = true;
+      throw TimeoutException('The runtime connection timed out.');
+    },
+  );
+  socket.pingInterval = const Duration(seconds: 20);
+  return IoRemoteSocket(socket);
+}
 
