diff --git a/lib/features/attention/agent_request_dialog.dart b/lib/features/attention/agent_request_dialog.dart
new file mode 100644
--- /dev/null
+++ b/lib/features/attention/agent_request_dialog.dart
@@ -0,0 +1,98 @@
+import 'package:flutter/material.dart';
+import '../../app/app_controller.dart';
+import '../../domain/models.dart';
+
+class AgentRequestDecision {
+  const AgentRequestDecision(this.answers);
+  final Map<String, List<String>> answers;
+}
+
+Future<AgentRequestDecision?> reviewAgentRequest(
+  BuildContext context,
+  AppController controller,
+  AttentionItem item,
+  AllowedRemoteAction action,
+) async {
+  final detail = await controller.approvalDetails(item);
+  if (!context.mounted) return null;
+  final questions = (detail['questions'] as List? ?? []).cast<Map>();
+  final answers = <String, List<String>>{};
+  return showDialog<AgentRequestDecision>(
+    context: context,
+    builder: (dialogContext) => StatefulBuilder(
+      builder: (context, setState) => AlertDialog(
+        title: Text(
+          action.type == RemoteActionType.answer
+              ? 'Answer agent'
+              : action.label,
+        ),
+        content: SizedBox(
+          width: 480,
+          child: SingleChildScrollView(
+            child: Column(
+              mainAxisSize: MainAxisSize.min,
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(
+                  detail['summary'] as String? ?? 'Review the agent request',
+                ),
+                if ((detail['command'] as String? ?? '').isNotEmpty)
+                  SelectableText(detail['command'] as String),
+                if ((detail['target'] as String? ?? '').isNotEmpty)
+                  SelectableText(detail['target'] as String),
+                for (final question in questions) ...[
+                  const SizedBox(height: 16),
+                  Text(question['question'] as String),
+                  for (final option in (question['options'] as List? ?? []))
+                    ListTile(
+                      contentPadding: EdgeInsets.zero,
+                      title: Text(option['label'] as String),
+                      subtitle: Text(option['description'] as String? ?? ''),
+                      selected:
+                          answers[question['id']]?.contains(option['label']) ==
+                          true,
+                      onTap: () => setState(
+                        () => answers[question['id'] as String] = [
+                          option['label'] as String,
+                        ],
+                      ),
+                    ),
+                  if ((question['options'] as List? ?? []).isEmpty ||
+                      question['isOther'] == true)
+                    TextField(
+                      obscureText: question['isSecret'] == true,
+                      decoration: const InputDecoration(
+                        labelText: 'Your answer',
+                      ),
+                      onChanged: (value) => setState(
+                        () => answers[question['id'] as String] = [value],
+                      ),
+                    ),
+                ],
+              ],
+            ),
+          ),
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.pop(dialogContext),
+            child: const Text('Cancel'),
+          ),
+          FilledButton(
+            onPressed:
+                questions.every(
+                  (q) =>
+                      answers[q['id']]?.any((a) => a.trim().isNotEmpty) == true,
+                )
+                ? () => Navigator.pop(
+                    dialogContext,
+                    AgentRequestDecision(answers),
+                  )
+                : null,
+            child: Text(action.label),
+          ),
+        ],
+      ),
+    ),
+  );
+}
