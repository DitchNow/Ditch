diff --git a/test/mac_mediated.test.ts b/test/mac_mediated.test.ts
new file mode 100644
--- /dev/null
+++ b/test/mac_mediated.test.ts
@@ -0,0 +1,28 @@
+import { env, SELF } from "cloudflare:test";
+import { beforeEach, expect, it } from "vitest";
+import { FakePrincipal, resetDatabase, seedOwned } from "./support/harness";
+import { validateProjectionRecord } from "../src/validation";
+
+beforeEach(resetDatabase);
+it("retired SSH nodes cannot authenticate, appear in the phone roster, or use an earlier socket ticket", async () => {
+  const mac = await FakePrincipal.create("machine", "22222222-2222-4222-8222-222222222222");
+  const phone = await FakePrincipal.create("device", "11111111-1111-4111-8111-111111111111");
+  await seedOwned(mac, phone, "55555555-5555-4555-8555-555555555555");
+  const ticket = await (await phone.request("/v1/auth/socket-ticket", {method:"POST",body:{machine_id:mac.id,role:"device",connection_epoch:crypto.randomUUID()}})).json<{ticket:string}>();
+  expect((await mac.request("/v1/machines")).status).toBe(200);
+  await env.DB.prepare("UPDATE machines SET machine_type='ssh_remote_node' WHERE id=?").bind(mac.id).run();
+  expect((await mac.request("/v1/machines")).status).toBe(401);
+  const roster = await (await phone.request("/v1/machines")).json<{machines:unknown[]}>();
+  expect(roster.machines).toEqual([]);
+  expect((await phone.request("/v1/auth/socket-ticket", {method:"POST",body:{machine_id:mac.id,role:"device",connection_epoch:crypto.randomUUID()}})).status).not.toBe(201);
+  expect((await SELF.fetch(`https://relay.test/v1/socket?ticket=${ticket.ticket}`,{headers:{Upgrade:"websocket"}})).status).not.toBe(101);
+  expect((await phone.request(`/v1/machines/${mac.id}/projection`)).status).not.toBe(200);
+});
+
+it("accepts target availability as Mac project metadata and rejects arbitrary states", () => {
+  const project = {project_id:"22222222-2222-4222-8222-222222222222",name:"SSH project",status:"running",running_count:1,
+    waiting_count:0,ready_count:0,failed_count:0,attention_count:0,last_activity_at:Date.now(),projection_version:1,
+    target_host:"dev-box",target_status:"reconnecting"};
+  expect(()=>validateProjectionRecord("project",project)).not.toThrow();
+  expect(()=>validateProjectionRecord("project",{...project,target_status:"execute"})).toThrow();
+});
