{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theditch.dev/remote/v1/projection.schema.json",
  "title": "ProjectionWebSocketEnvelope",
  "oneOf": [
    { "$ref": "#/$defs/snapshotBegin" },
    { "$ref": "#/$defs/snapshotRecord" },
    { "$ref": "#/$defs/snapshotCommit" },
    { "$ref": "#/$defs/incrementalUpdate" },
    { "$ref": "#/$defs/projectionAck" },
    { "$ref": "#/$defs/projectionGap" }
  ],
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "sessions", "attention"],
      "properties": {
        "projects": { "type": "integer", "minimum": 0 },
        "sessions": { "type": "integer", "minimum": 0 },
        "attention": { "type": "integer", "minimum": 0 }
      }
    },
    "epochMilliseconds": {
      "type": "integer",
      "description": "Signed 64-bit Unix epoch milliseconds. RFC3339 strings are invalid.",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "projectRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "name",
        "status",
        "running_count",
        "waiting_count",
        "ready_count",
        "failed_count",
        "attention_count",
        "last_activity_at",
        "projection_version"
      ],
      "properties": {
        "target_host": { "type": "string", "maxLength": 128 },
        "target_status": { "enum": ["online", "offline", "reconnecting", "unknown"] },
        "project_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 40 },
        "running_count": { "type": "integer", "minimum": 0 },
        "waiting_count": { "type": "integer", "minimum": 0 },
        "ready_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "attention_count": { "type": "integer", "minimum": 0 },
        "last_activity_at": { "$ref": "#/$defs/epochMilliseconds" },
        "projection_version": { "type": "integer", "minimum": 1 }
      }
    },
    "sessionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "project_id",
        "title",
        "provider_name",
        "status",
        "semantic_phase",
        "needs_user",
        "attention_count",
        "changed_file_count",
        "validation_summary",
        "integration_readiness",
        "last_activity_at",
        "projection_version"
      ],
      "properties": {
        "session_id": { "type": "string", "format": "uuid" },
        "project_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "maxLength": 240 },
        "provider_name": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "maxLength": 40 },
        "semantic_phase": { "type": ["string", "null"], "maxLength": 240 },
        "needs_user": { "type": "boolean" },
        "attention_count": { "type": "integer", "minimum": 0 },
        "changed_file_count": { "type": ["integer", "null"], "minimum": 0 },
        "validation_summary": { "type": ["string", "null"], "maxLength": 240 },
        "integration_readiness": { "type": ["string", "null"], "maxLength": 240 },
        "last_activity_at": { "$ref": "#/$defs/epochMilliseconds" },
        "projection_version": { "type": "integer", "minimum": 1 }
      }
    },
    "attentionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention_id", "project_id", "session_id", "type", "severity", "summary", "state", "remote_actions", "projection_version"],
      "properties": {
        "attention_id": { "type": "string", "format": "uuid" },
        "project_id": { "type": ["string", "null"], "format": "uuid" },
        "session_id": { "type": ["string", "null"], "format": "uuid" },
        "type": { "type": "string", "maxLength": 64 },
        "severity": { "type": "string", "maxLength": 24 },
        "summary": { "type": "string", "maxLength": 240 },
        "state": { "type": "string", "maxLength": 32 },
        "remote_actions": { "type": "array", "maxItems": 8, "items": { "type": "object" } },
        "projection_version": { "type": "integer", "minimum": 1 }
      }
    },
    "deleteRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "id"],
      "properties": {
        "entity": { "enum": ["project", "session", "attention"] },
        "id": { "type": "string", "format": "uuid" }
      }
    },
    "snapshotBegin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "message_id", "type", "created_at", "payload"],
      "properties": {
        "protocol_version": { "const": 1 },
        "message_id": { "type": "string", "format": "uuid" },
        "type": { "const": "projection_snapshot_begin" },
        "created_at": { "$ref": "#/$defs/epochMilliseconds" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_id", "machine_id", "epoch", "sequence", "counts"],
          "properties": {
            "owner_id": { "type": "string", "format": "uuid" },
            "machine_id": { "type": "string", "format": "uuid" },
            "epoch": { "type": "string", "format": "uuid" },
            "sequence": { "type": "integer", "const": 1 },
            "counts": { "$ref": "#/$defs/counts" }
          }
        }
      }
    },
    "snapshotRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "message_id", "type", "created_at", "payload"],
      "properties": {
        "protocol_version": { "const": 1 },
        "message_id": { "type": "string", "format": "uuid" },
        "type": { "const": "projection_snapshot_record" },
        "created_at": { "$ref": "#/$defs/epochMilliseconds" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_id", "machine_id", "epoch", "sequence", "kind", "record"],
          "properties": {
            "owner_id": { "type": "string", "format": "uuid" },
            "machine_id": { "type": "string", "format": "uuid" },
            "epoch": { "type": "string", "format": "uuid" },
            "sequence": { "type": "integer", "minimum": 2 },
            "kind": { "enum": ["project", "session", "attention"] },
            "record": { "type": "object" }
          },
          "allOf": [
            { "if": { "properties": { "kind": { "const": "project" } } }, "then": { "properties": { "record": { "$ref": "#/$defs/projectRecord" } } } },
            { "if": { "properties": { "kind": { "const": "session" } } }, "then": { "properties": { "record": { "$ref": "#/$defs/sessionRecord" } } } },
            { "if": { "properties": { "kind": { "const": "attention" } } }, "then": { "properties": { "record": { "$ref": "#/$defs/attentionRecord" } } } }
          ]
        }
      }
    },
    "snapshotCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "message_id", "type", "created_at", "payload"],
      "properties": {
        "protocol_version": { "const": 1 },
        "message_id": { "type": "string", "format": "uuid" },
        "type": { "const": "projection_snapshot_commit" },
        "created_at": { "$ref": "#/$defs/epochMilliseconds" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_id", "machine_id", "epoch", "sequence", "counts"],
          "properties": {
            "owner_id": { "type": "string", "format": "uuid" },
            "machine_id": { "type": "string", "format": "uuid" },
            "epoch": { "type": "string", "format": "uuid" },
            "sequence": { "type": "integer", "minimum": 2 },
            "counts": { "$ref": "#/$defs/counts" }
          }
        }
      }
    },
    "incrementalUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "message_id", "type", "created_at", "payload"],
      "properties": {
        "protocol_version": { "const": 1 },
        "message_id": { "type": "string", "format": "uuid" },
        "type": { "const": "projection_update" },
        "created_at": { "$ref": "#/$defs/epochMilliseconds" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_id", "machine_id", "epoch", "sequence", "kind", "record"],
          "properties": {
            "owner_id": { "type": "string", "format": "uuid" },
            "machine_id": { "type": "string", "format": "uuid" },
            "epoch": { "type": "string", "format": "uuid" },
            "sequence": { "type": "integer", "minimum": 1 },
            "kind": { "enum": ["project", "session", "attention", "delete"] },
            "record": { "type": "object" }
          },
          "allOf": [
            { "if": { "properties": { "kind": { "const": "project" } } }, "then": { "properties": { "record": { "$ref": "#/$defs/projectRecord" } } } },
            { "if": { "properties": { "kind": { "const": "session" } } }, "then": { "properties": { "record": { "$ref": "#/$defs/sessionRecord" } } } },
            { "if": { "properties": { "kind": { "const": "attention" } } }, "then": { "properties": { "record": { "$ref": "#/$defs/attentionRecord" } } } },
            { "if": { "properties": { "kind": { "const": "delete" } } }, "then": { "properties": { "record": { "$ref": "#/$defs/deleteRecord" } } } }
          ]
        }
      }
    },
    "projectionAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "message_id", "type", "created_at", "payload"],
      "properties": {
        "protocol_version": { "const": 1 },
        "message_id": { "type": "string", "format": "uuid" },
        "type": { "const": "projection_ack" },
        "created_at": { "$ref": "#/$defs/epochMilliseconds" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["epoch", "accepted_sequence", "status"],
          "properties": {
            "epoch": { "type": "string", "format": "uuid" },
            "accepted_sequence": { "type": "integer", "minimum": 1 },
            "status": { "enum": ["applied", "duplicate"] }
          }
        }
      }
    },
    "projectionGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "message_id", "type", "created_at", "payload"],
      "properties": {
        "protocol_version": { "const": 1 },
        "message_id": { "type": "string", "format": "uuid" },
        "type": { "const": "projection_gap" },
        "created_at": { "$ref": "#/$defs/epochMilliseconds" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["epoch", "expected_sequence", "received_sequence", "full_snapshot_required"],
          "properties": {
            "epoch": { "type": "string", "format": "uuid" },
            "expected_sequence": { "type": "integer", "minimum": 1 },
            "received_sequence": { "type": "integer", "minimum": 1 },
            "full_snapshot_required": { "const": true }
          }
        }
      }
    }
  }
}
