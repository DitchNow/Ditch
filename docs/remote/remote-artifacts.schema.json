{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theditch.dev/remote/runtime-artifacts-v1.schema.json",
  "title": "Ditch remote runtime artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edition",
    "version",
    "build_identifier",
    "community_revision",
    "remote_runtime_protocol_version",
    "artifacts"
  ],
  "properties": {
    "edition": { "const": "community" },
    "version": { "type": "string", "minLength": 1 },
    "build_identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "community_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "remote_runtime_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "sha256", "artifact"],
        "properties": {
          "target": {
            "enum": [
              "x86_64-unknown-linux-gnu",
              "aarch64-unknown-linux-gnu",
              "aarch64-apple-darwin",
              "x86_64-apple-darwin"
            ]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "artifact": { "type": "string", "pattern": "^ditchd-[A-Za-z0-9_-]+$" }
        }
      }
    }
  }
}
