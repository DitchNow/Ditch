# Public verification values used by official staging/production app builds.
# Copy this file to .env.release.staging or .env.release.production. Never put
# the corresponding Sparkle or P-256 private signing keys in a macOS app file.
DITCH_SPARKLE_PUBLIC_ED_KEY=BASE64_ED25519_PUBLIC_KEY
DITCH_RELEASE_MANIFEST_PUBLIC_KEY_SEC1_B64=BASE64_P256_SEC1_PUBLIC_KEY
DITCH_APPLE_TEAM_ID=APPLE_TEAM_ID
DITCH_COMMUNITY_BUILD_SEQUENCE=BUILD_SEQUENCE
